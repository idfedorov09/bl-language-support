{
  "name": "bl-language-support",
  "displayName": "Поддержка языка Z8 BL",
  "description": "Поддержка языка Z8 BL для VS Code: навигация и ссылки",
  "version": "1.1.0",
  "publisher": "idfedorov09",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "bl",
    "z8",
    "language",
    "extension",
    "syntax",
    "navigation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/idfedorov09/bl-language-support.git"
  },
  "bugs": {
    "url": "https://github.com/idfedorov09/bl-language-support/issues"
  },
  "homepage": "https://github.com/idfedorov09/bl-language-support#readme",
  "activationEvents": [
    "onLanguage:bl",
    "onCommand:bl.showContext",
    "onCommand:bl.analyzeLine",
    "onCommand:bl.dumpDiagnostics"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:corpus": "node test/corpus.js"
  },
  "contributes": {
    "configuration": {
      "title": "Поддержка языка Z8 BL",
      "properties": {
        "bl.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Проверять BL-код и показывать диагностику. Навигация работает независимо от этой настройки."
        },
        "bl.diagnostics.mode": {
          "type": "string",
          "enum": [
            "onType",
            "onSave"
          ],
          "enumDescriptions": [
            "Проверять после паузы при вводе, при открытии и сохранении.",
            "Проверять только при открытии и сохранении."
          ],
          "default": "onType",
          "scope": "resource",
          "description": "Когда запускать диагностику BL."
        },
        "bl.diagnostics.delay": {
          "type": "integer",
          "default": 300,
          "minimum": 0,
          "maximum": 5000,
          "scope": "resource",
          "description": "Задержка диагностики после последнего изменения, в миллисекундах. Используется в режиме onType."
        },
        "bl.index.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/build/**"
          ],
          "scope": "window",
          "description": "Glob-паттерны исключений фоновой индексации BL. Открытые файлы разбираются по требованию; не исключайте необходимые BL-зависимости."
        },
        "bl.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Показывать над объявлениями BL ссылки на native и скомпилированный Java."
        },
        "bl.debug.trace": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Выводить дополнительные трассы диагностики в BL Debug. Команды отладки работают и без этой настройки."
        }
      }
    },
    "languages": [
      {
        "id": "bl",
        "extensions": [
          ".bl"
        ],
        "aliases": [
          "BL",
          "bl"
        ],
        "icon": {
          "light": "./images/bl-file-icon.png",
          "dark": "./images/bl-file-icon.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "bl.goToCompiledJava",
        "title": "BL: Перейти к скомпилированному Java"
      },
      {
        "command": "bl.goToNativeJava",
        "title": "BL: Перейти к нативному Java"
      },
      {
        "command": "bl.showContext",
        "title": "BL: Показать контекст (debug)"
      },
      {
        "command": "bl.analyzeLine",
        "title": "BL: Анализ текущей строки"
      },
      {
        "command": "bl.dumpDiagnostics",
        "title": "BL: Вывод диагностик"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "bl.goToCompiledJava",
          "when": "resourceLangId == bl",
          "group": "navigation@100"
        },
        {
          "command": "bl.goToNativeJava",
          "when": "resourceLangId == bl",
          "group": "navigation@101"
        },
        {
          "command": "bl.analyzeLine",
          "when": "resourceLangId == bl",
          "group": "navigation@200"
        },
        {
          "command": "bl.dumpDiagnostics",
          "when": "resourceLangId == bl",
          "group": "navigation@201"
        }
      ]
    },
    "grammars": [
      {
        "language": "bl",
        "scopeName": "source.bl",
        "path": "./syntaxes/bl.tmLanguage.json"
      }
    ]
  }
}
